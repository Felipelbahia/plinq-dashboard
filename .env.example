# ==============================================================================
# PLINQ SUPORTE DASHBOARD · VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Configure estas variáveis nas configurações do projeto na Vercel (Project Settings > Environment Variables)
# ou crie um arquivo local .env para desenvolvimento.

# URL do seu projeto Supabase (ex: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anon do Supabase (role 'anon')
SUPABASE_ANON_KEY=sua-chave-anon-aqui
